<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/autel_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#99000000"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_zone_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="EDS | DRONE: OFF"
            android:textColor="#00E676"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_distance_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DIST: ---m"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_drone_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DRONE: --%"
            android:textColor="#FFC107" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar"
        android:layout_margin="10dp"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_saved_easting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Easting : ---"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_saved_northing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Northing: ---"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_saved_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Height  : ---"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_fos_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S1: Waiting"
            android:textColor="#B0BEC5" />

        <TextView
            android:id="@+id/tv_fos_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S2: Waiting"
            android:textColor="#B0BEC5" />

        <TextView
            android:id="@+id/tv_ffe_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO TARGET LOCKED"
            android:textColor="#FF5252"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_live_drone_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="TGT E: --- | N: --- | H: ---m"
            android:textColor="#40C4FF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_lock_target"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LOCK" />

            <Button
                android:id="@+id/btn_record_shot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SHOT" />

            <Button
                android:id="@+id/btn_rth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RTH" />

            <Button
                android:id="@+id/btn_voice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MIC" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
