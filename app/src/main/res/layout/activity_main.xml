<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. ड्रोन लाइव वीडियो फ़ीड कंटेनर (पूरी स्क्रीन पर) -->
    <FrameLayout
        android:id="@+id/autel_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212" />

    <!-- 2. ऊपर का स्टेटस बार (Drone Status, Distance, Battery) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#99000000"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_zone_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="EDS | DRONE: OFF | OT: ---°"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_distance_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="DIST: ---m"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_drone_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="DRONE: --%"
            android:textColor="#FFC107"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. बाईं तरफ़ टारगेट और शॉट डेटा पैनल -->
    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_bar"
        android:layout_alignParentStart="true"
        android:layout_margin="10dp"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_saved_easting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Easting : ---"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_saved_northing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Northing: ---"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_saved_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Height  : ---"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="#55FFFFFF" />

        <TextView
            android:id="@+id/tv_fos_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S1: Waiting"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_fos_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="S2: Waiting"
            android:textColor="#B0BEC5"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_ffe_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="NO TARGET LOCKED"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4. नीचे लाइव ग्रिड और कंट्रोल बटन्स -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_live_drone_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:text="TGT E: --- | N: --- | H: ---m"
            android:textColor="#40C4FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_lock_target"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#D32F2F"
                android:text="LOCK TARGET"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_record_shot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1976D2"
                android:text="RECORD SHOT"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_rth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#F57C00"
                android:text="RTH"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_voice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#388E3C"
                android:text="MIC: ON"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
